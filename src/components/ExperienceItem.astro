---
import LinkInline from './LinkInLine.astro'

interface Props {
  title: string
  company: string
  description: string | string[]
  link?: string
  location?: string
  date: string
}

const { title, company, description, link, location, date } = Astro.props
const descriptionItems = Array.isArray(description) ? description : [description]
---

<div
  class="relative mx-4 grid pb-12 before:absolute before:left-[-20px] before:block before:h-full before:border-l-2 before:border-black/20 before:content-[''] dark:before:border-white/15 md:mx-12 md:grid-cols-5 md:gap-10]"
>
  <div class="relative pb-6 md:col-span-2 md:pb-12">
    <div class="sticky top-24">
      <span class="text-green-800 dark:text-green-200/90 absolute -left-[27px] rounded-full text-5xl md:-left-[42px]"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-green-800 dark:text-green-200/90">{title}</h3>
      <h4 class="text-xl font-semibold text-gray-700 dark:text-white">{company}</h4>
      <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium text-gray-600/85 dark:text-gray-200">
        {location && <span class="rounded-full border border-neutral-400/80 px-3 py-1 dark:border-white/10">{location}</span>}
        <time class="rounded-full border border-neutral-400/80 px-3 py-1 dark:border-white/10">{date}</time>
      </div>
    </div>
  </div>
  <div class="relative md:col-span-3">
    <div class="flex flex-col gap-4 rounded-3xl border border-neutral-300/80 bg-neutral-200/70 p-5 text-pretty text-gray-700 shadow-sm dark:border-white/10 dark:bg-white/10 dark:text-gray-200 md:p-6">
      <ul class="list-disc space-y-3 pl-5 marker:text-green-800 dark:marker:text-green-200/90">
        {descriptionItems.map((item) => <li>{item}</li>)}
      </ul>
      {
        link && (
          <LinkInline href={link}>
            Saber más{" "}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 icon icon-tabler icon-tabler-chevron-right"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 6l6 6l-6 6" />
              </>
            </svg>
          </LinkInline>
        )
      }
    </div>
  </div>
</div>
