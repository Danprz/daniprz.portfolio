---
import AWS from "../components/icons/AWS.astro";
import Airflow from "../components/icons/Airflow.astro";
import DBT from "../components/icons/DBT.astro";
import Git from "../components/icons/Git.astro";
import Microsoft from "../components/icons/Microsoft.astro";
import Node from "../components/icons/Node.astro";
import PostgreSQL from "../components/icons/PostgreSQL.astro";
import Python from "../components/icons/Python.astro";
import SQL from "../components/icons/SQLServer.astro";

type Skill = {
  name: string;
  short: string;
  icon?: typeof AWS;
  imageSrc?: string;
  imageAlt?: string;
  imageClass?: string;
  accent: {
    background: string;
    color: string;
    border: string;
  };
};

const skills: Skill[] = [
  {
    name: "Databricks",
    short: "DBX",
    imageSrc: "/databricks.svg",
    imageAlt: "Databricks logo",
    imageClass: "max-h-8 max-w-11 object-contain",
    accent: {
      background: "linear-gradient(135deg, rgba(239, 68, 68, 0.18), rgba(255, 255, 255, 0.04))",
      color: "#dc2626",
      border: "rgba(239, 68, 68, 0.22)",
    },
  },
  {
    name: "Azure",
    short: "AZ",
    imageSrc: "/AZURE.svg",
    imageAlt: "Azure logo",
    imageClass: "max-h-9 max-w-9 object-contain",
    accent: {
      background: "linear-gradient(135deg, rgba(59, 130, 246, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#2563eb",
      border: "rgba(59, 130, 246, 0.22)",
    },
  },
  {
    name: "Azure Data Factory",
    short: "ADF",
    imageSrc: "/data-factories.svg",
    imageAlt: "Azure Data Factory logo",
    imageClass: "max-h-8 max-w-8 object-contain",
    accent: {
      background: "linear-gradient(135deg, rgba(14, 165, 233, 0.18), rgba(255, 255, 255, 0.04))",
      color: "#0284c7",
      border: "rgba(14, 165, 233, 0.22)",
    },
  },
  {
    name: "Spark",
    short: "SPK",
    imageSrc: "/apache_spark.svg",
    imageAlt: "Apache Spark logo",
    imageClass: "max-h-8 max-w-11 object-contain",
    accent: {
      background: "linear-gradient(135deg, rgba(249, 115, 22, 0.18), rgba(255, 255, 255, 0.04))",
      color: "#ea580c",
      border: "rgba(249, 115, 22, 0.22)",
    },
  },
  {
    name: "Amazon Web Services (AWS)",
    short: "AWS",
    icon: AWS,
    accent: {
      background: "linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(255, 255, 255, 0.04))",
      color: "#d97706",
      border: "rgba(245, 158, 11, 0.22)",
    },
  },
  {
    name: "Azure DevOps",
    short: "ADO",
    imageSrc: "/azure-devops.svg",
    imageAlt: "Azure DevOps logo",
    imageClass: "max-h-8 max-w-8 object-contain",
    accent: {
      background: "linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(255, 255, 255, 0.04))",
      color: "#4f46e5",
      border: "rgba(99, 102, 241, 0.22)",
    },
  },
  {
    name: "Python",
    short: "PY",
    icon: Python,
    accent: {
      background: "linear-gradient(135deg, rgba(59, 130, 246, 0.14), rgba(234, 179, 8, 0.12))",
      color: "#2563eb",
      border: "rgba(59, 130, 246, 0.22)",
    },
  },
  {
    name: "SQL Server",
    short: "SQL",
    icon: SQL,
    accent: {
      background: "linear-gradient(135deg, rgba(220, 38, 38, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#b91c1c",
      border: "rgba(220, 38, 38, 0.22)",
    },
  },
  {
    name: "PostgreSQL",
    short: "PG",
    icon: PostgreSQL,
    accent: {
      background: "linear-gradient(135deg, rgba(37, 99, 235, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#1d4ed8",
      border: "rgba(37, 99, 235, 0.22)",
    },
  },
  {
    name: "Airflow",
    short: "AF",
    icon: Airflow,
    accent: {
      background: "linear-gradient(135deg, rgba(14, 165, 233, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#0284c7",
      border: "rgba(14, 165, 233, 0.22)",
    },
  },
  {
    name: "DBT",
    short: "DBT",
    icon: DBT,
    accent: {
      background: "linear-gradient(135deg, rgba(249, 115, 22, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#c2410c",
      border: "rgba(249, 115, 22, 0.22)",
    },
  },
  {
    name: "Node.js",
    short: "N",
    icon: Node,
    accent: {
      background: "linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#15803d",
      border: "rgba(34, 197, 94, 0.22)",
    },
  },
  {
    name: "Git & GitHub",
    short: "GIT",
    icon: Git,
    accent: {
      background: "linear-gradient(135deg, rgba(251, 113, 133, 0.16), rgba(255, 255, 255, 0.04))",
      color: "#be123c",
      border: "rgba(251, 113, 133, 0.22)",
    },
  },
  {
    name: "MS Tools",
    short: "MS",
    icon: Microsoft,
    accent: {
      background: "linear-gradient(135deg, rgba(99, 102, 241, 0.14), rgba(255, 255, 255, 0.04))",
      color: "#4338ca",
      border: "rgba(99, 102, 241, 0.22)",
    },
  },
];
---

<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
  {
    skills.map((skill) => {
      const Icon = skill.icon;

      return (
        <div
          class="group relative overflow-hidden rounded-2xl border border-neutral-300/80 bg-neutral-200/70 p-4 transition duration-300 hover:-translate-y-1 hover:border-neutral-400 dark:border-white/10 dark:bg-white/10 dark:hover:border-white/20"
        >
          <div
            class="absolute inset-x-0 top-0 h-20 opacity-70 blur-2xl transition duration-300 group-hover:opacity-100"
            style={`background: ${skill.accent.background};`}
            aria-hidden="true"
          />
          <div class="relative flex flex-col gap-4">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-2xl border bg-white/70 shadow-sm dark:bg-neutral-950/30"
              style={`border-color: ${skill.accent.border}; color: ${skill.accent.color};`}
            >
              {skill.imageSrc ? (
                <img
                  src={skill.imageSrc}
                  alt={skill.imageAlt ?? `${skill.name} logo`}
                  class:list={["h-auto w-auto", skill.imageClass ?? "max-h-8 max-w-8 object-contain"]}
                  loading="lazy"
                />
              ) : Icon ? (
                <Icon class="size-8" />
              ) : (
                <span class="text-sm font-bold tracking-[0.22em]">{skill.short}</span>
              )}
            </div>
            <p class="text-sm font-semibold leading-snug text-neutral-800 dark:text-white/90">
              {skill.name}
            </p>
          </div>
        </div>
      );
    })
  }
</div>
