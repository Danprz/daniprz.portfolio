---
import { getI18N } from "../i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const accents = [
  {
    background: "linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(255, 255, 255, 0.02))",
    color: "#047857"
  },
  {
    background: "linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(255, 255, 255, 0.02))",
    color: "#1d4ed8"
  },
  {
    background: "linear-gradient(135deg, rgba(249, 115, 22, 0.18), rgba(255, 255, 255, 0.02))",
    color: "#c2410c"
  },
  {
    background: "linear-gradient(135deg, rgba(168, 85, 247, 0.16), rgba(255, 255, 255, 0.02))",
    color: "#7c3aed"
  }
];
---

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {
    i18n.impact.items.map((item, index) => {
      const accent = accents[index % accents.length];

      return (
        <article class="group relative overflow-hidden rounded-3xl border border-neutral-300/80 bg-neutral-200/70 p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-neutral-400 dark:border-white/10 dark:bg-white/10 dark:hover:border-white/20">
          <div
            class="absolute inset-x-0 top-0 h-24 opacity-80 blur-3xl transition duration-300 group-hover:opacity-100"
            style={`background: ${accent.background};`}
            aria-hidden="true"
          />
          <div class="relative flex h-full flex-col gap-3">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-neutral-500 dark:text-white/50">
              {item.label}
            </p>
            <p class="break-words text-2xl font-semibold leading-tight tracking-tight md:text-[1.75rem] lg:text-[2rem]" style={`color: ${accent.color};`}>
              {item.value}
            </p>
            <p class="text-sm leading-6 text-neutral-700 dark:text-white/75">{item.detail}</p>
          </div>
        </article>
      );
    })
  }
</div>
