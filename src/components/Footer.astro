---
import { getI18N } from "../i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto mt-20 w-full max-w-5xl px-4 pb-10">
  <div class="rounded-[2rem] border border-neutral-300/80 bg-neutral-200/70 p-6 shadow-sm dark:border-white/10 dark:bg-white/10 md:p-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-neutral-500 dark:text-white/45">
          {i18n.footer.eyebrow}
        </p>
        <p class="mt-2 text-2xl font-semibold tracking-tight text-neutral-950 dark:text-white">
          {i18n.footer.title}
        </p>
        <p
          set:html={i18n.footer.subtitle}
          class="mt-3 text-sm leading-7 text-green-800/80 dark:text-green-200/75 [&_strong]:font-semibold [&_strong]:text-green-800 dark:[&_strong]:text-green-200/95"
        />
        <p class="mt-4 text-sm text-neutral-500 dark:text-white/45">© {currentYear}</p>
      </div>

      <div class="flex flex-wrap gap-3 text-sm font-medium">
        <a
          href="mailto:danprz.dev@gmail.com"
          class="rounded-full border border-neutral-400 bg-white/80 px-4 py-2 text-neutral-800 transition hover:-translate-y-0.5 hover:bg-white dark:border-white/10 dark:bg-black/20 dark:text-white"
        >
          {i18n.footer.contact}
        </a>
        <a
          href="https://www.linkedin.com/in/dan-prz/"
          target="_blank"
          rel="noopener"
          class="rounded-full border border-neutral-400 bg-white/80 px-4 py-2 text-neutral-800 transition hover:-translate-y-0.5 hover:bg-white dark:border-white/10 dark:bg-black/20 dark:text-white"
        >
          {i18n.footer.linkedin}
        </a>
        <a
          href="https://github.com/Danprz/"
          target="_blank"
          rel="noopener"
          class="rounded-full border border-neutral-400 bg-white/80 px-4 py-2 text-neutral-800 transition hover:-translate-y-0.5 hover:bg-white dark:border-white/10 dark:bg-black/20 dark:text-white"
        >
          {i18n.footer.github}
        </a>
      </div>
    </div>
  </div>
</footer>
